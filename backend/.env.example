# ─────────────────────────────────────────────
# Invoice RAG Chatbot — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Gemini API (Version 1 — default) ──────────
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model names (defaults shown)
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_VISION_MODEL=gemini-3.5-flash

# ── Custom SLM Endpoint (Version 2 — optional) ─
# Uncomment and set to your Colab / ngrok / Ollama URL
# When LLM_BASE_URL is set, the app uses the OpenAI SDK
# pointed at this endpoint instead of the Gemini SDK.
# LLM_BASE_URL=https://xxxx.ngrok-free.app/v1
# LLM_API_KEY=not-needed          # some servers need a dummy key
# LLM_CHAT_MODEL=mistral-7b-instruct   # model name served by the SLM

# ── FAISS Vector Store ────────────────────────────────────────
# Directory where the FAISS index and metadata JSON are stored
CHROMA_PERSIST_DIR=../chroma_db
CHROMA_COLLECTION_NAME=invoices

# ── Upload directory ───────────────────────────
UPLOAD_DIR=../uploads

# ── Server ─────────────────────────────────────
HOST=127.0.0.1
PORT=8000
